# soc-autopilot Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# LLM API (development pipeline only)
GEMINI_API_KEY=your_key_here

# Lab endpoints (required for CI tools with live lab)
LAB_URL=https://127.0.0.1
WAZUH_USER=readonly_user
WAZUH_TOKEN=your_token
PFSENSE_USER=readonly_user
PFSENSE_TOKEN=your_token

# Optional overrides
VRAM_BUDGET_MB=
